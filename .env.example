# ============================================
# ChurnGuard Frontend – Environment Variables
# ============================================
# Copy this file to .env and fill in values as needed.
# Nothing here is required to run the app in demo mode.

# --- Vite (client-side, exposed to the browser — never put secrets here) ---

# true = use local mock data for customers/dashboard/etc. (default, no backend needed)
# false = call a real FastAPI backend at VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Base URL of the FastAPI backend (only used when VITE_USE_MOCK_API=false)
VITE_API_BASE_URL=http://localhost:8000/api

# true = AI Assistant tries the live Grok proxy (server.js) before falling back to demo replies
# false = AI Assistant always uses local demo replies (default)
VITE_USE_LIVE_ASSISTANT=false

# Where the frontend sends assistant requests (proxied to server.js in dev, see vite.config.js)
VITE_ASSISTANT_API_URL=/api/assistant

# --- Server (server.js — NEVER exposed to the browser) ---

# Your xAI Grok API key. Required only if VITE_USE_LIVE_ASSISTANT=true.
# Get one at https://x.ai. Never commit this value.
XAI_API_KEY=

# Grok model to use for the assistant proxy.
XAI_MODEL=grok-4-fast

# Port the assistant proxy server (server.js) listens on.
ASSISTANT_PORT=8787
