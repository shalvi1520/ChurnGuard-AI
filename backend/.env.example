# ============================================
# ChurnGuard Backend – Environment Variables
# ============================================
#
# Copy to `backend/.env` and fill in. This file is committed; `.env` is not.
#
# Everything here is BACKEND-ONLY and must stay that way. Never copy any of
# these into a VITE_* variable: Vite inlines those into the JavaScript bundle
# it serves to every visitor, so a client secret placed there is published
# rather than configured. The frontend needs none of it — it only ever links
# to /api/auth/google and lets the backend do the rest.
#
# See AUTH_SETUP.md for step-by-step provider setup.


# --- Required ---------------------------------------------------------------

# Where accounts, sessions, dataset history and trained-model records live.
# Postgres is what this project runs on:
DATABASE_URL=postgresql://user:password@localhost:5432/churnguard
# SQLite works identically and needs no server — the same schema, the same
# code, no frontend change. Uncomment to use it instead:
# DATABASE_URL=sqlite:///./churnguard.db

# Signs the Bearer tokens used for API scripting and tests. No default: a
# server that cannot verify its own tokens should fail to start rather than
# sign with a guessable secret.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=


# --- Deployment -------------------------------------------------------------

# `development` (default) or `production`. Production sets Secure on the
# session cookie, so it is only ever sent over HTTPS. Leaving this at
# development on a public deployment would send session cookies in the clear.
APP_ENV=development

# Where the two halves of the app live. These build the OAuth redirect URIs
# and the link in a password-reset email, so they must match reality. If Vite
# picked a different port (5174, 5175, ...), update FRONTEND_URL to match.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Comma-separated allowed origins. Left unset, any localhost/127.0.0.1 port is
# allowed — right for development, wrong for production. Set it explicitly
# when deploying.
# CORS_ORIGINS=https://app.yourdomain.com

# Only needed when the API and the app are on different registrable domains
# (not merely different subdomains). `none` also requires HTTPS. Same-domain
# deployments should leave this at the default `lax`.
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=


# --- Google sign-in (optional) ----------------------------------------------
#
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Register the redirect URI below EXACTLY as written —
# a mismatch is rejected as `redirect_uri_mismatch`.
#
# Leave blank to disable: the Google button is then disabled and says it is
# not configured. It never fakes a sign-in.

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback


# --- Password-reset email (optional) ----------------------------------------
#
# Without SMTP_HOST the reset flow still works end to end, but nothing is
# sent: the link is written to the backend log and the UI says plainly that
# email delivery is not configured. It never claims a message was sent.
#
# Gmail needs an App Password, not your account password.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ChurnGuard <no-reply@churnguard.local>
SMTP_USE_TLS=true


# --- Existing integrations --------------------------------------------------

# Encrypts stored CRM tokens at rest (Fernet).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# LLM providers for outreach drafting, mapping suggestions and the Explainability
# summary. Tried in this order; each is used only once its key is set, so a
# second key is what makes the fallback real when Groq is rate-limited.
GROQ_API_KEY=
# Gemini fallback. GOOGLE_API_KEY is accepted too. This is an AI Studio key, NOT the
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET pair used for "Sign in with Google".
GEMINI_API_KEY=
# Optional: pin a different Gemini model id if the default is ever retired.
# GEMINI_MODEL=

# HubSpot private-app token, for the CRM connector.
HUBSPOT_ACCESS_TOKEN=
