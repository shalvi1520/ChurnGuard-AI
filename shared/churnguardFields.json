      "label": "Service / product tier",
      "description": "Which product or service line the customer is on.",
      "example": "Fiber optic",
      "required": false,
      "whyNeeded": "Lets you see whether churn concentrates on one product line or tier.",
      "lookFor": "A short list of product or service names: Basic/Pro/Enterprise, Fiber/DSL, Standard/Premium.",
      "aliases": [
