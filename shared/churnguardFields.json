{
  "_comment": "THE canonical ChurnGuard field definition. Read directly by the frontend (src/mock/datasetSchema.js) and the backend (backend/api/schema.py) so the two can never drift. Do not create a second copy of this list anywhere.",
  "version": 4,
  "fields": [
    {
      "key": "customer_id",
      "label": "Customer ID",
      "description": "A unique reference for each customer or account.",
      "example": "7590-VHVEG",
      "required": true,
      "whyNeeded": "Every prediction, explanation and outreach draft is keyed to one account. Without an identifier there is nothing to attach a risk score to.",
      "lookFor": "A column where nearly every value is different — an account number, customer code, client reference or record ID.",
      "aliases": [
        "customerid",
        "customer",
        "custid",
        "cust",
        "accountid",
        "account",
        "accountnumber",
        "accountno",
        "acctid",
        "acctno",
        "clientid",
        "client",
        "clientref",
        "clientreference",
        "id",
        "userid",
        "subscriberid",
        "subscriber",
        "customernumber",
        "customerref",
        "customercode",
        "customerkey",
        "memberid",
        "contactid",
        "recordid",
        "uid",
        "externalid",
        "reference"
      ],
      "keywords": [
        "customer",
        "client",
        "account",
        "subscriber",
        "member",
        "user",
        "id",
        "identifier",
        "number",
        "ref",
        "reference",
        "code",
        "key"
      ],
      "expect": {
        "kind": "identifier",
        "uniqueRatioMin": 0.9
      }
    },
    {
      "key": "tenure",
      "label": "Tenure (months)",
      "description": "How long the customer has been with you, in months.",
      "example": "34",
      "required": true,
      "whyNeeded": "How long an account has been with you is one of the strongest churn signals there is — new relationships behave very differently from established ones.",
      "lookFor": "A whole number of months: months active, subscription duration, account age, time as a customer.",
      "aliases": [
        "tenure",
        "tenuremonths",
        "tenureinmonths",
        "months",
        "monthsactive",
        "monthssubscribed",
        "monthsassubscriber",
        "monthswithus",
        "monthssincesignup",
        "monthssincejoin",
        "customerage",
        "accountage",
        "subscriptionmonths",
        "subscriptionduration",
        "subscriptionlength",
        "durationmonths",
        "lengthofservice",
        "servicelength",
        "timeascustomer",
        "membershipduration",
        "relationshiplength",
        "agemonths",
        "nummonths",
        "monthcount"
      ],
      "keywords": [
        "tenure",
        "months",
        "month",
        "duration",
        "length",
        "age",
        "subscribed",
        "active",
        "since",
        "signup",
        "period",
        "time",
        "relationship",
        "membership"
      ],
      "expect": {
        "kind": "numeric",
        "min": 0,
        "max": 1200,
        "integerish": true
      }
    },
    {
      "key": "monthly_charges",
      "label": "Monthly charges",
      "description": "What the customer is billed each month.",
      "example": "56.95",
      "required": false,
      "whyNeeded": "Recurring revenue is what makes an at-risk account expensive to lose — it is what Revenue at Risk is calculated from. Not every business bills per customer (a free/subscription-tier product may have no such column), so ChurnGuard trains without it when it's genuinely absent rather than blocking on it.",
      "lookFor": "A money amount charged every month: monthly fee, recurring charge, MRR, monthly spend.",
      "aliases": [
        "monthlycharges",
        "monthlycharge",
        "monthlyfee",
        "monthlyfees",
        "monthlyspend",
        "monthlyrevenue",
        "monthlybill",
        "monthlyamount",
        "monthlycost",
        "monthlyprice",
        "monthlyvalue",
        "mrr",
        "arpu",
        "recurringfee",
        "recurringcharge",
        "recurringrevenue",
        "recurringamount",
        "subscriptionfee",
        "subscriptionprice",
        "subscriptioncost",
        "subscriptionvalue",
        "billingamount",
        "feepermonth",
        "chargepermonth",
        "amountpermonth",
        "rateplanamount"
      ],
      "keywords": [
        "monthly",
        "month",
        "charge",
        "charges",
        "fee",
        "fees",
        "spend",
        "revenue",
        "bill",
        "billing",
        "amount",
        "cost",
        "price",
        "recurring",
        "rate",
        "mrr",
        "arpu",
        "subscription"
      ],
      "expect": {
        "kind": "numeric",
        "min": 0
      }
    },
    {
      "key": "contract_type",
      "label": "Contract type",
      "description": "The plan or commitment length, e.g. month-to-month or annual.",
      "example": "One year",
      "required": false,
      "whyNeeded": "Commitment length changes churn behaviour more than almost any other field — a month-to-month account can leave at any time. Not every business has a contract/plan-length concept (e.g. e-commerce, or a product with no formal commitment), so ChurnGuard trains without it when it's genuinely absent rather than blocking on it.",
      "lookFor": "A short list of repeating labels: month-to-month, one year, annual, monthly, 12-month.",
      "aliases": [
        "contract",
        "contracttype",
        "contractterm",
        "contractlength",
        "contractplan",
        "plan",
        "plantype",
        "planname",
        "pricingplan",
        "subscriptiontype",
        "subscriptionplan",
        "agreement",
        "agreementtype",
        "agreementterm",
        "term",
        "termlength",
        "termtype",
        "commitment",
        "commitmentlength",
        "billingcycle",
        "billingfrequency",
        "billingterm",
        "renewalterm"
      ],
      "keywords": [
        "contract",
        "plan",
        "agreement",
        "term",
        "commitment",
        "cycle",
        "renewal",
        "subscription",
        "type",
        "frequency"
      ],
      "expect": {
        "kind": "categorical",
        "maxDistinct": 24
      }
    },
    {
      "key": "churn",
      "label": "Churn outcome",
      "description": "Whether the customer has already left. ChurnGuard learns your churn patterns from this column.",
      "example": "Yes / No",
      "required": true,
      "whyNeeded": "ChurnGuard needs a historical churn/cancellation outcome to train the prediction model — without it there is nothing for the model to learn from.",
      "lookFor": "A two-value column recording who already left: Yes/No, 1/0, True/False, Churned/Active, Cancelled/Retained.",
      "aliases": [
        "churn",
        "churned",
        "churnlabel",
        "churnflag",
        "churnvalue",
        "churnstatus",
        "customerchurn",
        "ischurn",
