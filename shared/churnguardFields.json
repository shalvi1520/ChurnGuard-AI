    },
    {
      "key": "total_charges",
      "label": "Total charges",
      "description": "Total revenue billed to the customer so far.",
      "example": "1889.50",
      "required": false,
      "whyNeeded": "Lifetime spend gives the model a sense of how much an account has already invested in you.",
      "lookFor": "A cumulative money amount: total billed, lifetime value, revenue to date.",
      "aliases": [
